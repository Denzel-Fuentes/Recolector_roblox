{
  "name": "CleanRecycle",
  "tree": {
    "$className": "DataModel",

    "ReplicatedFirst": {
      "$path": "src/ReplicatedFirst"
    },

    "ReplicatedStorage": {
      "Packages": {
        "$className": "Folder",
        "Fusion": {
          "$path": "src/ReplicatedStorage/Packages/Fusion"
        }
      },
      "Shared": {
        "$className": "Folder",
        "Config": {
          "$path": "src/ReplicatedStorage/Shared/Config"
        },
        "Events": {
          "$path": "src/ReplicatedStorage/Shared/Events"
        },
        "Utilidades": {
          "$path": "src/ReplicatedStorage/Shared/Utilidades"
        }
      }
    },

    "ServerScriptService": {
      "Services": {
        "$path": "src/ServerScriptService/Services"
      }
    },

    "ServerStorage": {
      "Herramientas": {
        "$path": "src/ServerStorage/Herramientas"
      }
    },

    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },

    "StarterGui": {
      "$properties": {
        "ScreenOrientation": "LandscapeSensor"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CharacterWalkSpeed": 16
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Client"
        }
      }
    },

    "Workspace": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "Anchored": true,
          "Color": [0.376, 0.659, 0.227],
          "Locked": true,
          "Material": "SmoothPlastic",
          "Position": [-26.25, -10, 39],
          "Size": [145.5, 20, 276]
        }
      }
    },

    "Lighting": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "Ambient": [0.51, 0.51, 0.51],
        "OutdoorAmbient": [0.647, 0.667, 0.686],
        "ColorShift_Top": [1, 0.98, 0.92],
        "ColorShift_Bottom": [0, 0, 0],
        "Brightness": 2.6,
        "ExposureCompensation": 0,
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.2,
        "ClockTime": 13.5,
        "GlobalShadows": true,
        "ShadowSoftness": 0.4,
        "Outlines": false,
        "Technology": "ShadowMap"
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
